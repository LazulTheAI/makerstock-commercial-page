{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "makerstock-commercial-page.vercel.app" }],
      "destination": "https://www.makerstocks.com/:path*",
      "permanent": true
    },
    { "source": "/privacy", "destination": "/fr/legal/privacy.html", "permanent": false },
    { "source": "/tos",     "destination": "/fr/legal/tos.html",     "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options",        "value": "DENY" },
        { "key": "X-XSS-Protection",       "value": "1; mode=block" },
        { "key": "Referrer-Policy",        "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy",     "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/(.*)\\.(html|css|js)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    }
  ]
}
