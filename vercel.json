{
  "rewrites": [
    { "source": "/", "destination": "/fr/index.html" }
  ],
  "redirects": [
    { "source": "/privacy", "destination": "/fr/legal/privacy.html", "permanent": false },
    { "source": "/tos",     "destination": "/fr/legal/tos.html",     "permanent": false },
    { "source": "/en/privacy", "destination": "/en/legal/privacy.html", "permanent": false },
    { "source": "/es/privacy", "destination": "/es/legal/privacy.html", "permanent": false }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options",        "value": "DENY" },
        { "key": "X-XSS-Protection",       "value": "1; mode=block" },
        { "key": "Referrer-Policy",        "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy",     "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/(.*)\\.(html|css|js)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    }
  ]
}
